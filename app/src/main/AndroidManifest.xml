<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Required for TextToSpeech to discover an engine on Android 11 (API 30) and
        above. Without this, package-visibility filtering hides every TTS service,
        TextToSpeech.onInit never reports success, and TextToSpeechHelper.speak()
        silently returns without producing audio.
        See https://developer.android.com/training/tts/
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize">
            <!--
                singleTop, so the notification's PendingIntent is delivered to the running
                activity rather than constructing a second one.

                Without it this activity was `standard`, which made `onNewIntent` unreachable -
                Android only calls it when the existing instance is reused, and with `standard`
                it never is. So the handler written for the notification's `navigate_to` extra
                could not run, and tapping the alert while the app was open produced a *second*
                MainActivity. That second instance gets its own `MainViewModel`, because the
                view model is Activity-scoped: a second repository set, a second pronunciation
                service, and a second review session, with the first still alive behind it. Two
                entries in the recents list for one app.

                `singleTop` is the minimum that fixes it. `singleTask` would also work but would
                additionally clear anything stacked above the activity, which is more than
                opening the review deck requires.
            -->
            <!--
                adjustResize, with imePadding() on the screens that need it.

                The app calls enableEdgeToEdge(), which sets decorFitsSystemWindows = false,
                so from API 30 the window does not resize for the keyboard and no content is
                inset above it. Those screens handle the IME themselves. Below API 30 the
                system still resizes the window for us, and this is what makes that happen -
                without it the keyboard covers the bottom third of Add Word and the "Approve &
                Add to SRS Deck" button is unreachable while typing.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
