<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
   The Room database holds users.passwordHash and users.token. An empty
   <full-backup-content> means "back up everything", so the database must be
   excluded explicitly or credential hashes are uploaded to Google Drive.
   Applies to Android 11 (API 30) and below; API 31+ uses data_extraction_rules.xml.
-->
    <exclude domain="database" path="hanzi_srs_database" />
</full-backup-content>
