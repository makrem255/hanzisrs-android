<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
   Excludes the Room database (hanzi_srs_database), which stores users.passwordHash
   and users.token, from automatic Google Drive backup. An empty <cloud-backup>
   element means "include everything".
-->
        <exclude domain="database" path="hanzi_srs_database" />
    </cloud-backup>
    <!--
    Device-to-device transfer is deliberately left unrestricted: it is an explicit
    user action to the learner's own new hardware, so review history survives a
    phone upgrade.
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>
