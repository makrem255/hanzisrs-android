# Backend environment. Copy to `.env` and fill in.
# `.env` is gitignored. Never commit a real key.
#
# Load it before starting:  node --env-file=.env server.mjs   (Node 20+)
# Or export the variables through your platform's secret store, which is preferred in production.

# The Gemini API key. Server-side only. This is the credential that used to be shipped in the APK.
GEMINI_API_KEY=

# Which model to call.
GEMINI_MODEL=gemini-3.5-flash

# Port to listen on.
PORT=8080

# Requests per minute per client address. A ceiling, not an authentication mechanism.
RATE_LIMIT_PER_MINUTE=30

# Set to "true" ONLY when running behind a proxy that overwrites X-Forwarded-For (nginx, a load
# balancer). Leaving it false makes the server trust the socket address, which is the safe default:
# a client can set the header itself and escape its own rate limit.
TRUST_PROXY=false